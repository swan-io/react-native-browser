{
  "name": "@swan-io/react-native-browser-example",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf ./node_modules ./ios/Pods",
    "start": "react-native start",
    "android": "react-native run-android --list-devices",
    "ios": "react-native run-ios",
